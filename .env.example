# Copy this file to .env and fill in real values.
# The workshop's OpenAI streaming example (07) and project 1 (streaming chat) require OPENAI_API_KEY.
# Project 2 (webhook dashboard) reads WEBHOOK_SECRET but has a default if unset.

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Optional: only needed if you swap the in-memory state for real persistence
MONGODB_URI=mongodb+srv://user:pass@host/?appName=...
MONGODB_DB=skynova

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:password@db.host:5432/postgres

# Used by examples/04_webhooks and project 2
WEBHOOK_SECRET=change-me-for-real-deployments

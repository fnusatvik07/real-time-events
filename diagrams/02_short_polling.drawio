                <mxCell id="title1" value="Short Polling - Client keeps asking on a timer" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="920" height="34" as="geometry"/></mxCell>
<mxCell id="sub2" value="Average latency = poll interval / 2.  Cost = N redundant requests per minute, even when nothing changes." style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="920" height="22" as="geometry"/></mxCell>

        <mxfile host="app.diagrams.net">
          <diagram name="04_polling_comparison" id="04_polling_comparison">
            <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                          tooltips="1" connect="1" arrows="1" fold="1" page="1"
                          pageScale="1" pageWidth="1100" pageHeight="580"
                          math="0" shadow="0">
              <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title1" value="Short vs Long Polling - Side by Side" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1020" height="34" as="geometry"/></mxCell>
<mxCell id="sub2" value="Same 30-second window. Short polling burns 15 requests. Long polling uses 2." style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1020" height="22" as="geometry"/></mxCell>
<mxCell id="box3" value="SHORT POLLING&#10;&#10;Many short requests on a fixed timer.&#10;Avg latency  ≈  interval / 2&#10;Server work  ≈  N requests / minute (even when idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="470" height="120" as="geometry"/></mxCell>
<mxCell id="box4" value="LONG POLLING&#10;&#10;Few requests, each held until data arrives.&#10;Avg latency  ≈  near-zero on event&#10;Server work  ≈  one held connection per client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="470" height="120" as="geometry"/></mxCell>
<mxCell id="cap5" value="Timeline (30s) - R = full HTTP round-trip" style="text;html=1;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="cap6" value="Timeline (30s) - = = held connection, R = data flushed" style="text;html=1;align=center;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="code7" value="R|R|R|R|R|R|R|R|R|R|R|R|R|R|R|&#10;↑ 15 requests, 12 returned nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="470" height="50" as="geometry"/></mxCell>
<mxCell id="code8" value="============R||============R||&#10;↑ 2 requests, both delivered data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;spacingBottom=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="285" width="470" height="50" as="geometry"/></mxCell>
<mxCell id="note9" value="When to use which&#10;&#10;Short polling  →  rare events OK to be a few seconds stale, simple to ship, any backend supports it.&#10;&#10;Long polling   →  lower latency without holding 100K WebSockets, async server, no aggressive proxy timeouts.&#10;&#10;Need &lt;100ms latency or two-way?  Skip both. Use SSE or WebSockets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="950" height="140" as="geometry"/></mxCell>
              </root>
            </mxGraphModel>
          </diagram>
        </mxfile>

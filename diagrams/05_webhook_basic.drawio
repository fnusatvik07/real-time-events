        <mxfile host="app.diagrams.net">
          <diagram name="05_webhook_basic" id="05_webhook_basic">
            <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                          tooltips="1" connect="1" arrows="1" fold="1" page="1"
                          pageScale="1" pageWidth="1100" pageHeight="620"
                          math="0" shadow="0">
              <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title1" value="Webhooks - Inversion. The third party calls YOU." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1020" height="34" as="geometry"/></mxCell>
<mxCell id="sub2" value="Zero idle traffic. Server only does work when events fire. You expose a URL; they POST to it." style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1020" height="22" as="geometry"/></mxCell>
<mxCell id="sl3" value="Lifecycle of a webhook" style="text;html=1;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="940" height="20" as="geometry"/></mxCell>
<mxCell id="cap4" value="① SETUP (once)  -  you register your URL in their dashboard" style="text;html=1;align=center;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="80" y="145" width="940" height="18" as="geometry"/></mxCell>
<mxCell id="cap5" value="② EVENT HAPPENS  -  customer pays $50 on Stripe" style="text;html=1;align=center;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="80" y="165" width="940" height="18" as="geometry"/></mxCell>
<mxCell id="box6" value="THIRD-PARTY SERVICE&#10;(Stripe / GitHub / Slack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="box7" value="YOUR SERVER&#10;https://you.com/webhooks/stripe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="e8" value="③ POST + signed body  (x-signature: ...)" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#333;strokeWidth=2.5;fontSize=11;edgeStyle=none;" edge="1" parent="1" source="box6" target="box7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ack_arrow" value="④ 200 OK (fast)" style="endArrow=classic;html=1;strokeWidth=1.6;fontSize=11;dashed=1;strokeColor=#888;edgeStyle=none;" edge="1" parent="1" source="box7" target="box6"><mxGeometry x="-1" y="40" relative="1" as="geometry"><mxPoint y="40" as="offset"/></mxGeometry></mxCell>
<mxCell id="note9" value="Why it's good&#10;&#10;Zero idle cost. No requests until something happens.&#10;Push (not pull) - first-byte latency is near zero.&#10;&#10;The cost: you must verify signatures, dedup retries, and return 200 fast (see next two diagrams)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="120" y="410" width="860" height="160" as="geometry"/></mxCell>
              </root>
            </mxGraphModel>
          </diagram>
        </mxfile>

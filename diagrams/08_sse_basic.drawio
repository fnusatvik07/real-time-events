                          math="0" shadow="0">
              <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title1" value="Server-Sent Events - server pushes a stream over one HTTP connection" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1020" height="34" as="geometry"/></mxCell>
<mxCell id="sub2" value="Browser-native via EventSource.  Auto-reconnect.  Just text/event-stream over plain HTTP." style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1020" height="22" as="geometry"/></mxCell>
<mxCell id="lane3" value="BROWSER&#10;new EventSource('/stream')" style="shape=swimlane;horizontal=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;swimlaneFillColor=#ffffff;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="220" height="402" as="geometry"/></mxCell>
<mxCell id="lane4" value="SERVER&#10;Content-Type: text/event-stream" style="shape=swimlane;horizontal=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;swimlaneFillColor=#ffffff;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="220" height="402" as="geometry"/></mxCell>
<mxCell id="msg5" value="GET /stream  Accept: text/event-stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="440" height="28" as="geometry"/></mxCell>
<mxCell id="msg6" value="200 OK  (connection stays open)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="222" width="440" height="28" as="geometry"/></mxCell>
<mxCell id="msg7" value="data: hello" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="264" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="msg8" value="data: world" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="304" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="msg9" value="event: token&#10;data: {&quot;text&quot;:&quot;Hi&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="344" width="440" height="42" as="geometry"/></mxCell>
<mxCell id="msg10" value=": keep-alive ping  (comment line, ignored by client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="440" height="26" as="geometry"/></mxCell>
<mxCell id="msg11" value="event: done&#10;data: complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="440" height="42" as="geometry"/></mxCell>
<mxCell id="note12" value="What the browser does for free&#10;• onmessage / addEventListener('token', e =&gt; ...)&#10;• auto-reconnect on dropped connection&#10;• sends Last-Event-ID header on reconnect → server resumes from there" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="542" width="920" height="90" as="geometry"/></mxCell>
              </root>
            </mxGraphModel>

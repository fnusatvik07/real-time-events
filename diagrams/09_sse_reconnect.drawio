                <mxCell id="title1" value="SSE Auto-Reconnect + Resume with Last-Event-ID" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1020" height="34" as="geometry"/></mxCell>
<mxCell id="sub2" value="Connection drops? Browser reconnects automatically and tells the server what it last saw." style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1020" height="22" as="geometry"/></mxCell>
<mxCell id="lane3" value="BROWSER" style="shape=swimlane;horizontal=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;swimlaneFillColor=#ffffff;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="180" height="518" as="geometry"/></mxCell>
<mxCell id="lane4" value="SERVER" style="shape=swimlane;horizontal=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;swimlaneFillColor=#ffffff;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="180" height="518" as="geometry"/></mxCell>
<mxCell id="msg5" value="GET /stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="510" height="26" as="geometry"/></mxCell>
<mxCell id="msg6" value="id: 1&#10;data: msg-a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="510" height="42" as="geometry"/></mxCell>
<mxCell id="msg7" value="id: 2&#10;data: msg-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="266" width="510" height="42" as="geometry"/></mxCell>
<mxCell id="msg8" value="✗  CONNECTION DROPS  (network blip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="322" width="510" height="28" as="geometry"/></mxCell>
<mxCell id="msg9" value="Browser waits ~3 sec, then reconnects automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="364" width="510" height="26" as="geometry"/></mxCell>
<mxCell id="msg10" value="GET /stream&#10;Last-Event-ID: 2  ← browser tells server what it last saw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="404" width="510" height="42" as="geometry"/></mxCell>
<mxCell id="msg11" value="Server replays from buffer: events with id &gt; 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="510" height="26" as="geometry"/></mxCell>
<mxCell id="msg12" value="id: 3&#10;data: msg-c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="510" height="42" as="geometry"/></mxCell>
<mxCell id="msg13" value="id: 4&#10;data: msg-d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="556" width="510" height="42" as="geometry"/></mxCell>
<mxCell id="note14" value="The Last-Event-ID resume is built into the browser. You only need to:&#10;1.  Include `id:` lines in every event you send.&#10;2.  On reconnect, check the `Last-Event-ID` request header and replay newer events from a buffer or log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="658" width="920" height="80" as="geometry"/></mxCell>

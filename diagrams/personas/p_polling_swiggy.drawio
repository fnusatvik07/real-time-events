<mxCell id="b2" value="Swiggy backend&#10;Order service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#fc8019;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="e3" value="GET /orders/123  (every 2 seconds)" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="{&quot;status&quot;: &quot;cooking&quot;}  (same status again)" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=1.6;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;dashed=1;edgeStyle=none;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c5" value="Of 25 polls during an order:&#10;  about 5 catch a real status change (placed -&gt; confirmed -&gt; cooking -&gt; out for delivery -&gt; delivered)&#10;  the other 20 return the same status as last time - that's 80% wasted requests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="270" width="920" height="110" as="geometry"/></mxCell>
<mxCell id="c6" value="When polling is fine&#10;Status updates that don't need sub-second latency. Small client counts. Backends that don't push." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="920" height="70" as="geometry"/></mxCell>

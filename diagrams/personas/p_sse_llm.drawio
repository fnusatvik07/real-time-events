<mxCell id="c8" value="Why proxy through Maya's backend instead of letting the browser call OpenAI directly?&#10;&#10;  1.  The API key never reaches the browser.&#10;  2.  Maya can log/filter/rate-limit prompts.&#10;  3.  Cookies and domain stay simple - the browser only talks to liveorder.app." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="960" height="110" as="geometry"/></mxCell>

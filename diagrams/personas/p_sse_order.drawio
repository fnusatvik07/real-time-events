        <mxfile host="app.diagrams.net">
          <diagram name="p_sse_order" id="p_sse_order">
            <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
                          tooltips="1" connect="1" arrows="1" fold="1" page="1"
                          pageScale="1" pageWidth="1120" pageHeight="500"
                          math="0" shadow="0">
              <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="d1" value="Raj's phone&#10;Order tracking screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="b2" value="Maya's backend&#10;GET /orders/123/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="e3" value="GET /orders/123/stream  Accept: text/event-stream" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=1.6;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="event: status   data: {&quot;status&quot;: &quot;cooking&quot;}" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=1.6;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;dashed=1;edgeStyle=none;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c5" value="Same one HTTP connection.  As the order progresses, the server pushes an event for each transition:&#10;&#10;   paid  -&gt;  restaurant_confirmed  -&gt;  cooking  -&gt;  out_for_delivery  -&gt;  delivered&#10;&#10;Raj's phone sees each update within ~50ms. Zero polling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="270" width="920" height="100" as="geometry"/></mxCell>
<mxCell id="c6" value="Bonus: if the connection drops (subway tunnel), the browser auto-reconnects and sends Last-Event-ID. The server picks up exactly where it left off." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="390" width="920" height="80" as="geometry"/></mxCell>
              </root>
            </mxGraphModel>
          </diagram>
        </mxfile>

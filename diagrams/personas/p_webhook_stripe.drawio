                <mxCell id="1" parent="0"/>
                <mxCell id="d1" value="Raj pays&#10;Tap 'Pay 450 INR'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="b2" value="Stripe&#10;Payment processor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="60" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="b3" value="Maya's backend&#10;POST /webhooks/stripe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="170" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="d4" value="Priya's tablet&#10;Restaurant kitchen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="e5" value="card details" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=1.6;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;edgeStyle=none;" edge="1" parent="1" source="d1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="POST signed event  payment_intent.succeeded" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;edgeStyle=none;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="kitchen alert: new paid order #1234" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;dashed=1;edgeStyle=none;" edge="1" parent="1" source="b3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c8" value="Maya's backend has 5-10 seconds to respond 200. She verifies the HMAC, writes to a queue, returns 200. The kitchen notification happens asynchronously." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="1010" height="50" as="geometry"/></mxCell>
<mxCell id="c9" value="The 4 webhook rules&#10;&#10;1. Verify the signature (HMAC-SHA256 of the body with a shared secret).&#10;2. Dedup by event id - Stripe will sometimes deliver the same event twice.&#10;3. Return 200 fast - queue real work; don't do it in the handler.&#10;4. Return 200 (not 5xx) for events you don't care about; 5xx triggers retries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="1010" height="130" as="geometry"/></mxCell>
              </root>
            </mxGraphModel>

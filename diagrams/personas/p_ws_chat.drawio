<mxCell id="e7" value="&quot;Got it, calling now&quot;" style="endArrow=classic;startArrow=none;html=1;rounded=0;strokeColor=#bbb;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#0B0E14;edgeStyle=none;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c8" value="Polling: Raj would refresh every few seconds (laggy + wasteful).&#10;SSE: Sam could push to Raj, but Raj couldn't push back - dead-end for chat.&#10;WebSocket: both ways, low overhead per message, made for this." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="960" height="80" as="geometry"/></mxCell>
<mxCell id="c9" value="The cost: one open TCP connection per connected person. 50K users = real RAM. Use WebSocket only when truly bidirectional. SSE is fine for one-way streaming." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#111;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="960" height="70" as="geometry"/></mxCell>
              </root>

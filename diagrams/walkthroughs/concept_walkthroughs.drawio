charges card" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="160" height="80" as="geometry"/></mxCell><mxCell id="6" value="LiveOrder API receiver  —  POST /webhooks/stripe" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="420" height="220" as="geometry"/></mxCell><mxCell id="7" value="a.  verify HMAC signature   (constant-time compare)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="380" height="38" as="geometry"/></mxCell><mxCell id="8" value="b.  dedup by event id       (Redis SETNX, TTL = 24h)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="188" width="380" height="38" as="geometry"/></mxCell><mxCell id="9" value="c.  enqueue   then   return 200 OK   (&lt;100 ms end-to-end)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="236" width="380" height="38" as="geometry"/></mxCell><mxCell id="10" value="Redis queue
orders.paid" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="150" height="80" as="geometry"/></mxCell><mxCell id="11" value="Worker
(retry-safe)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="110" width="160" height="80" as="geometry"/></mxCell><mxCell id="12" value="1.  confirm" style="endArrow=classic;html=1;rounded=0;strokeColor=#1e88e5;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="150" as="sourcePoint"/><mxPoint x="260" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="2.  POST /webhooks/stripe" style="endArrow=classic;html=1;rounded=0;strokeColor=#e53935;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="150" as="sourcePoint"/><mxPoint x="480" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="3.  200 OK   (under 100 ms)" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontStyle=1;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="290" as="sourcePoint"/><mxPoint x="420" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4.  enqueue" style="endArrow=classic;html=1;rounded=0;strokeColor=#fb8c00;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="150" as="sourcePoint"/><mxPoint x="960" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="5.  pop" style="endArrow=classic;html=1;rounded=0;strokeColor=#fb8c00;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="150" as="sourcePoint"/><mxPoint x="1170" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="Postgres

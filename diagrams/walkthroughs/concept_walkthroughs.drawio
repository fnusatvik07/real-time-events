single endpoint" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="88" width="430" height="60" as="geometry"/></mxCell><mxCell id="7" value="Claude Desktop

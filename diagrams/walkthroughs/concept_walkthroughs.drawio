or=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="416" as="sourcePoint"/><mxPoint x="930" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="446" width="24" height="24" as="geometry"/></mxCell><mxCell id="30" value="SELECT * FROM restaurants WHERE earth_dist(...) &lt; 5km" style="endArrow=classic;html=1;rounded=0;strokeColor=#8e24aa;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="458" as="sourcePoint"/><mxPoint x="1130" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="rows" style="endArrow=classic;html=1;rounded=0;strokeColor=#8e24aa;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="486" as="sourcePoint"/><mxPoint x="930" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="516" width="24" height="24" as="geometry"/></mxCell><mxCell id="33" value="HTTP/1.1 200 OK    Content-Type: application/json    [{...}]" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;fontStyle=1;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="528" as="sourcePoint"/><mxPoint x="730" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="558" width="24" height="24" as="geometry"/></mxCell><mxCell id="35" value="bytes flow back through LB + OS  —  JSON parsed, list rendered" style="endArrow=classic;html=1;rounded=0;strokeColor=#1e88e5;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="570" as="sourcePoint"/><mxPoint x="130" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="600" width="24" height="24" as="geometry"/></mxCell><mxCell id="37" value="TCP connection stays OPEN (keep-alive)  —  the next request, e.g. GET /restaurants/1/menu, skips steps 2-4 entirely." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d4b600;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="597" width="1060" height="40" as="geometry"/></mxCell><mxCell id="38" value="STATELESS:   everything from step 6 onward had no idea it was Raj specifically.   The token is validated each time.   That's how Maya runs 50 backends in parallel with zero coordination between them." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="1200" height="60" as="geometry"/></mxCell>

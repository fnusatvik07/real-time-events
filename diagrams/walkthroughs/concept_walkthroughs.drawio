fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#b71c1c;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1620" height="24" as="geometry"/></mxCell><mxCell id="19" value="LLM call inside webhook handler" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b71c1c;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="513" height="60" as="geometry"/></mxCell><mxCell id="20" value="LLM takes 1-5s, sender times out at 5-10s.

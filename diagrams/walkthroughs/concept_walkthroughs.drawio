        <mxCell id="2" value="MCP transports compared  —  stdio  vs  HTTP+SSE  vs  Streamable HTTP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#000000;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1360" height="28" as="geometry"/></mxCell><mxCell id="3" value="Same protocol shape (one request, many events).   Three ways to ship the bytes." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1360" height="20" as="geometry"/></mxCell><mxCell id="4" value="stdio

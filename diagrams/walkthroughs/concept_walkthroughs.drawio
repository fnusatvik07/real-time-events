lor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="335" as="sourcePoint"/><mxPoint x="540" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="TCP open  (handshake #2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#e53935;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="170" y="313" width="180" height="16" as="geometry"/></mxCell><mxCell id="17" value="GET /b" style="endArrow=classic;html=1;rounded=0;strokeColor=#1e88e5;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="360" as="sourcePoint"/><mxPoint x="540" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="200 OK" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="385" as="sourcePoint"/><mxPoint x="160" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" style="endArrow=none;html=1;strokeColor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="415" as="sourcePoint"/><mxPoint x="540" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="TCP close" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#e53935;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="170" y="420" width="180" height="16" as="geometry"/></mxCell><mxCell id="21" style="endArrow=none;html=1;strokeColor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="460" as="sourcePoint"/><mxPoint x="540" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="TCP open  (handshake #3)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#e53935;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="170" y="438" width="180" height="16" as="geometry"/></mxCell><mxCell id="23" value="GET /c" style="endArrow=classic;html=1;rounded=0;strokeColor=#1e88e5;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="485" as="sourcePoint"/><mxPoint x="540" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="200 OK" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="510" as="sourcePoint"/><mxPoint x="160" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" style="endArrow=none;html=1;strokeColor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="540" as="sourcePoint"/><mxPoint x="540" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" value="TCP close" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#e53935;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="170" y="545" width="180" height="16" as="geometry"/></mxCell><mxCell id="27" value="3 requests  =  3 expensive TCP+TLS handshakes.
Each handshake is 1-3 round trips of network latency." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d4b600;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="540" height="55" as="geometry"/></mxCell><mxCell id="28" value="HTTP/1.1 keep-alive  —  reuse the same TCP connection" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="88" width="540" height="38" as="geometry"/></mxCell><mxCell id="29" value="Client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="140" width="140" height="40" as="geometry"/></mxCell><mxCell id="30" value="Server" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="140" height="40" as="geometry"/></mxCell><mxCell id="31" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="180" as="sourcePoint"/><mxPoint x="800" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="180" as="sourcePoint"/><mxPoint x="1180" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" style="endArrow=none;html=1;strokeColor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="210" as="sourcePoint"/><mxPoint x="1180" 
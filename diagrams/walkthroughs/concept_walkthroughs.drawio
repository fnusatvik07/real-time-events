SET paid = true" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="580" width="280" height="80" as="geometry"/></mxCell><mxCell id="18" value="6.  mark order paid" style="endArrow=classic;html=1;rounded=0;strokeColor=#8e24aa;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="380"/><mxPoint x="240" y="380"/></Array><mxPoint x="1200" y="190" as="sourcePoint"/><mxPoint x="240" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="Priya's tablet
restaurant new-order page" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="580" width="280" height="80" as="geometry"/></mxCell><mxCell id="20" value="7.  SSE: new paid order" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="420"/><mxPoint x="580" y="420"/></Array><mxPoint x="1235" y="190" as="sourcePoint"/><mxPoint x="580" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="Raj's phone
track-order page" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="580" width="280" height="80" as="geometry"/></mxCell><mxCell id="22" value="8.  SSE: payment confirmed" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="460"/><mxPoint x="920" y="460"/></Array><mxPoint x="1270" y="190" as="sourcePoint"/><mxPoint x="920" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="Email service
receipt to Raj" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="580" width="280" height="80" as="geometry"/></mxCell><mxCell id="24" value="9.  send receipt" style="endArrow=classic;html=1;rounded=0;strokeColor=#e53935;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="500"/><mxPoint x="1260" y="500"/></Array><mxPoint x="1305" y="190" as="sourcePoint"/><mxPoint x="1260" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="WHY THE SPLIT:   the API handler must return 200 within Stripe's 5-10s timeout.
Worker does the slow / retryable work.   If the DB is briefly down, the worker retries — without involving Stripe." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1420" height="70" as="geometry"/></mxCell><mxCell id="26" value="WHY DEDUP:   Stripe may deliver the same event id twice (lost ACK, internal retry).
SETNX in Redis is atomic — even two workers racing the same event process it exactly once." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d4b600;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1420" height="65" as="geometry"/></mxCell><mxCell id="27" value="WHY THE FAN-OUT IS ASYNC:   one paid event triggers DB + 2 SSE pushes + 1 email.
Worker fires them in parallel — none block any other." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1420" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

n=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="390" as="sourcePoint"/><mxPoint x="1180" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="200 OK" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="414" as="sourcePoint"/><mxPoint x="800" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" style="endArrow=none;html=1;strokeColor=#e53935;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="470" as="sourcePoint"/><mxPoint x="1180" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="42" value="TCP close  (eventually, after idle)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#e53935;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="810" y="475" width="200" height="16" as="geometry"/></mxCell><mxCell id="43" value="3 requests  =  1 handshake + 3 cheap exchanges.

        <mxCell id="2" value="HTTP/1.0 vs HTTP/1.1 keep-alive  —  why long-lived patterns are even possible" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#000000;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1260" height="28" as="geometry"/></mxCell><mxCell id="3" value="Same three requests, two protocol generations.  Count the TCP handshakes." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1260" height="20" as="geometry"/></mxCell><mxCell id="4" value="HTTP/1.0  —  one TCP connection per request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="88" width="540" height="38" as="geometry"/></mxCell><mxCell id="5" value="Client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="140" height="40" as="geometry"/></mxCell><mxCell id="6" value="Server" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="140" height="40" as="geometry"/></mxCell><mxCell id="7" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="180" as="sourcePoint"/><mxPoint x="160" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=1;dashPattern=4 4;" edge="1" parent=
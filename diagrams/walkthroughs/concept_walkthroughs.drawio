{ callback_url: 'https://you.com/callback/openai',
  input_file, model, ... }" style="endArrow=classic;html=1;rounded=0;strokeColor=#e53935;strokeWidth=1.6;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="218" as="sourcePoint"/><mxPoint x="960" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="{ id: 'batch_abc', status: 'validating' }" style="endArrow=classic;html=1;rounded=0;strokeColor=#e53935;strokeWidth=1.6;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="254" as="sourcePoint"/><mxPoint x="570" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="282" width="24" height="24" as="geometry"/></mxCell><mxCell id="16" value="202 Accepted   { 'we'll email when ready' }" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="294" as="sourcePoint"/><mxPoint x="180" y="294" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="·   ·   ·    minutes to hours pass     ·    user closes the tab,  goes for coffee    ·   ·   ·" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="130" y="334" width="980" height="36" as="geometry"/></mxCell><mxCell id="18" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="382" width="24" height="24" as="geometry"/></mxCell><mxCell id="19" value="running ... validating ... in_progress ... completed" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#8e24aa;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="850" y="384" width="220" height="24" as="geometry"/></mxCell><mxCell id="20" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="422" width="24" height="24" as="geometry"/></mxCell><mxCell id="21" value="POST /callback/openai
{ id: 'batch_abc', status: 'completed',
  output_file_id: 'file-xyz' }" style="endArrow=classic;html=1;rounded=0;strokeColor=#e53935;strokeWidth=1.6;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="434" as="sourcePoint"/><mxPoint x="570" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="200 OK  (verify, dedup, enqueue, return 200)" style="endArrow=classic;html=1;rounded=0;strokeColor=#43a047;strokeWidth=1.6;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="470" as="sourcePoint"/><mxPoint x="960" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="498" width="24" height="24" as="geometry"/></mxCell><mxCell id="24" value="store result   ·   send push or email" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#43a047;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="220" height="24" as="geometry"/></mxCell><mxCell id="25" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="528" width="24" height="24" as="geometry"/></mxCell><mxCell id="26" value="push notification / email
→ report ready, tap to view" style="endArrow=classic;html=1;rounded=0;strokeColor=#1e88e5;strokeWidth=1.6;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="540" as="sourcePoint"/><mxPoint x="180" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="WHY WEBHOOK:   the wait is hours.   Holding an SSE/WS connection for that long is wasteful and fragile.
Submit, walk away, get called back.   That's the same shape as Stripe / GitHub / Twilio." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1080" height="60" as="geometry"/></mxCell><mxCell id="28" value="callback_url is the entire mechanism.   The external service is essentially Stripe for a different domain (compute).
All four webhook rules still apply on /callback/openai:  verify signature, dedup by id, return 2xx fast, no 5xx for noise." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d4b600;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1080" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>

    {
      "name": "01 - HTTP basics (port 8101)",
      "description": "Realistic mini-backend: notes, JWT auth (real HS256), external API call to wttr.in. Start the server first:\n\n    cd examples/01_http_basics && uvicorn server:app --port 8101",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8101}}/",
              "host": [
                "{{base_8101}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Lists every endpoint this server exposes."
          }
        },
        {
          "name": "GET /time",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8101}}/time",
              "host": [

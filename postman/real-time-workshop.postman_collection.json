    {
      "name": "04 - Webhooks - Stripe payment for biryani (port 8104)",
      "description": "Send signed webhook events to a food-delivery backend. Each request has a pre-request script that HMAC-signs the body with the workshop secret.\n\nStart the receiver first:\n\n    cd examples/04_webhooks && uvicorn receiver:app --port 8104\n\nWatch the receiver's terminal too - it prints what the downstream worker would do (notify restaurant, send SMS, etc).",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8104}}/",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Info page + list of orders + count of events seen so far."
          }
        },
        {
          "name": "GET /orders  (current state of orders DB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8104}}/orders",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "POST /webhooks/stripe  (1) valid payment.succeeded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8104}}/webhooks/stripe",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            },
            "description": "Properly signed event. Server marks the order paid, notifies the restaurant, queues an SMS. Returns 200 with duplicate:false.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{event_id}}\",\n  \"type\": \"payment_intent.succeeded\",\n  \"created\": 1700000000,\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test123\",\n      \"amount\": 45000,\n      \"currency\": \"inr\",\n      \"customer\": \"cus_raj\",\n      \"metadata\": {\n        \"order_id\": \"order_raj_001\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique event id so dedup doesn't kick in. To deliberately test",
                  "// dedup, use the \"duplicate delivery\" request which uses a FIXED id.",
                  "var randomId = \"evt_pm_\" + Date.now() + \"_\" + Math.floor(Math.random()*1000);",
                  "pm.collectionVariables.set(\"event_id\", randomId);",
                  "",
                  "// HMAC-SHA256 sign the raw body with the webhook shared secret. The signature",
                  "// goes in the x-signature (or stripe-signature) header.",
                  "var secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "var body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : \"\";",
                  "var signature = CryptoJS.HmacSHA256(body, secret).toString();",
                  "pm.request.headers.upsert({key: \"x-signature\", value: signature});",
                  "pm.request.headers.upsert({key: \"stripe-signature\", value: signature});",
                  "console.log(\"Signed body, signature =\", signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /webhooks/stripe  (2) DUPLICATE delivery (test dedup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8104}}/webhooks/stripe",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            },
            "description": "HARD-CODED event id. Send this TWICE. First time: 200 with duplicate:false. Second time: 200 with duplicate:true - the dedup logic stops us from double-processing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_postman_fixed_for_dedup_test\",\n  \"type\": \"payment_intent.succeeded\",\n  \"created\": 1700000000,\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_fixed\",\n      \"amount\": 45000,\n      \"currency\": \"inr\",\n      \"customer\": \"cus_raj\",\n      \"metadata\": {\n        \"order_id\": \"order_raj_001\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// HMAC-SHA256 sign the raw body with the webhook shared secret. The signature",
                  "// goes in the x-signature (or stripe-signature) header.",
                  "var secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "var body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : \"\";",
                  "var signature = CryptoJS.HmacSHA256(body, secret).toString();",
                  "pm.request.headers.upsert({key: \"x-signature\", value: signature});",
                  "pm.request.headers.upsert({key: \"stripe-signature\", value: signature});",
                  "console.log(\"Signed body, signature =\", signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /webhooks/stripe  (3) charge.refunded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_8104}}/webhooks/stripe",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            },
            "description": "A refund event for the same order. Receiver marks it refunded and would tell the restaurant to cancel prep.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{event_id}}\",\n  \"type\": \"charge.refunded\",\n  \"created\": 1700000100,\n  \"data\": {\n    \"object\": {\n      \"id\": \"ch_xyz\",\n      \"amount_refunded\": 45000,\n      \"metadata\": {\n        \"order_id\": \"order_raj_001\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique event id so dedup doesn't kick in. To deliberately test",
                  "// dedup, use the \"duplicate delivery\" request which uses a FIXED id.",
                  "var randomId = \"evt_pm_\" + Date.now() + \"_\" + Math.floor(Math.random()*1000);",
                  "pm.collectionVariables.set(\"event_id\", randomId);",
                  "",
                  "// HMAC-SHA256 sign the raw body with the webhook shared secret. The signature",
                  "// goes in the x-signature (or stripe-signature) header.",
                  "var secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "var body = pm.request.body && pm.request.body.raw ? pm.request.body.raw : \"\";",
                  "var signature = CryptoJS.HmacSHA256(body, secret).toString();",
                  "pm.request.headers.upsert({key: \"x-signature\", value: signature});",
                  "pm.request.headers.upsert({key: \"stripe-signature\", value: signature});",
                  "console.log(\"Signed body, signature =\", signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /webhooks/stripe  (4) FORGED event (bad signature -> 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-signature",
                "value": "deadbeef_obviously_fake_signature"
              }
            ],
            "url": {
              "raw": "{{base_8104}}/webhooks/stripe",
              "host": [
                "{{base_8104}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            },
            "description": "No pre-request signing script. The hardcoded fake signature won't match anything the server computes -> 401. This is the demonstration that signature verification is what stops fraudsters.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_attacker_001\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_fake\",\n      \"amount\": 9999999,\n      \"currency\": \"inr\",\n      \"customer\": \"cus_attacker\",\n      \"metadata\": {\n        \"order_id\": \"order_raj_001\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "05 - SSE - real LLM stream relayed through your backend (port 8105)",
      "description": "Send a prompt; your local backend calls OpenAI with stream=True and relays each chunk back to you as an SSE event. This is the exact pattern Vercel AI SDK uses: browser speaks to YOUR domain over SSE, your backend speaks to OpenAI over SSE. The API key never leaves your server.\n\nStart the server first:\n\n    cd examples/05_sse && uvicorn server:app --port 8105\n\nRequires OPENAI_API_KEY in ../../.env.\n\nTip: in Postman, set the response viewer to 'Raw' to see the SSE wire format (id: / event: / data: / blank line, repeated). Tokens will appear one at a time as the model generates them.",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_8105}}/",
              "host": [
                "{{base_8105}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Info page. Also confirms whether OPENAI_API_KEY is configured (openai_key_configured: true|false)."
          }
        },
        {
          "name": "POST /chat  (real LLM stream - 3 Mumbai street foods)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{base_8105}}/chat",
              "host": [
                "{{base_8105}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Real call to OpenAI gpt-4o-mini, streamed through your backend. Postman will show the response body growing in real-time as the model generates each token. Watch the events:\n\n  event: open    once at the start, payload includes prompt + model\n  event: token   one per chunk, payload is {text, index}\n  event: done    once at the end, payload is {token_count}\n\nIf you see event: error instead, OPENAI_API_KEY is missing or invalid.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"What are 3 must-try Mumbai street foods? One short paragraph per dish.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /chat  (real LLM stream - custom prompt)",
          "request": {
